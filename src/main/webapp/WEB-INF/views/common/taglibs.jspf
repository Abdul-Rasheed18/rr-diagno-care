<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<fmt:setLocale value="en_IN" scope="request"/>
<c:set var="ctx" value="${pageContext.request.contextPath}" scope="request"/>
<c:set var="isAdmin" value="${pageContext.request.isUserInRole('ADMIN')}" scope="request"/>
<c:set var="isStaff" value="${pageContext.request.isUserInRole('STAFF')}" scope="request"/>
<c:set var="isPatient" value="${pageContext.request.isUserInRole('PATIENT')}" scope="request"/>
<c:set var="loggedIn" value="${not empty pageContext.request.userPrincipal}" scope="request"/>
<c:if test="${not empty _csrf}">
    <c:set var="csrfInput" scope="request"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/></c:set>
</c:if>
